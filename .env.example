# Optional: PostgreSQL. Leave unset to use the local .data/workflows.db SQLite database.
# DATABASE_URL=postgresql+psycopg://relay:relay_local@127.0.0.1:55432/relay
# DATA_DIR=.data
# Optional Fernet key. If unset, a private key is generated at .data/credential.key.
# CREDENTIAL_ENCRYPTION_KEY=

# Native local Ollama service; never stored in workflow JSON.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional canonical browser origin; unset supports localhost and 127.0.0.1 on port 3000.
# AUTH_ORIGIN=http://127.0.0.1:3000
# closed: first account only (default); invite: one-use operator token; open: local development.
AUTH_REGISTRATION_MODE=closed
# The launcher starts a separate durable worker and sets this false automatically.
# RELAY_EMBEDDED_WORKER=true

# Knowledge microservices (scripts/dev.py starts these on loopback).
# KB_MANAGEMENT_URL=http://127.0.0.1:8011
# KB_SEARCH_URL=http://127.0.0.1:8012
# KB_DATA_DIR=.data/knowledge
# Separate service-owned databases. Defaults are SQLite files in KB_DATA_DIR.
# KB_MANAGEMENT_DATABASE_URL=postgresql+psycopg://relay:relay_local@127.0.0.1:55432/relay_kb_management
# KB_SEARCH_DATABASE_URL=postgresql+psycopg://relay:relay_local@127.0.0.1:55432/relay_kb_search
# Shared Fernet service key; generated at DATA_DIR/kb-service.key when unset.
# KB_SERVICE_KEY=
# Optional local cross-encoder assets (default: DATA_DIR/reranker).
# Install with: .venv/bin/python -m scripts.install_reranker
# KB_RERANKER_DIR=.data/reranker

# Optional global operator override for /api/operator/metrics.
# Unset: the first workspace account is operator. Empty: deny all operators.
# RELAY_OPERATOR_ACCOUNT_IDS=account-id-one,account-id-two

# Run-wide ceiling on agent actions (tool calls plus specialist delegations).
# Per-agent limits live in each agent node's max_steps; this only stops a
# delegation tree from running away. Integer 1-200, default 40.
# AGENT_RUN_BUDGET=40
