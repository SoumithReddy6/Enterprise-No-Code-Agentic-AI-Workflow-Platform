.venv/
.data/
.env
.env.*
!.env.example
__pycache__/
.pytest_cache/
*.pyc
*.tsbuildinfo
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/.wrangler/
frontend/.vite-browser-tests/
frontend/test-results/
frontend/playwright-report/
frontend/.env*
!frontend/.env.example
.DS_Store

# Raw evaluation output is regenerated by every campaign. Commit the summaries
# (report.json, probe scripts, notes); keep logs, JUnit XML and persisted run
# histories local.
evals/results/**/*.log
evals/results/**/*.xml
evals/results/**/runs.json
evals/results/junit/
evals/results/production-ci/

# From the request reader campaign onward, commit summaries, hashes and gate results
# only. Full reports and rows stay local; summary.json records their SHA-256.
evals/results/request-reader-*/**/report.json
evals/results/request-reader-*/**/rows.json
