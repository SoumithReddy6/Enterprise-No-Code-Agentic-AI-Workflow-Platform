{
  "version": 1,
  "contract": 2,
  "name": "Support / ticket draft",
  "description": "Check a summary and category before routing a ticket draft. This example creates no ticket.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Chat input",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "reader",
      "type": "request_reader",
      "version": 1,
      "label": "Request reader",
      "position": {
        "x": 300,
        "y": 210
      },
      "inputs": {
        "message": "input.message"
      },
      "config": {
        "purpose": "Draft support tickets with a summary and a category of billing, technical or account. General unrelated questions are outside this workflow.",
        "accepted_requests": [
          "Support problems with a summary and a category."
        ],
        "excluded_requests": [
          "Unrelated questions and greetings without a request."
        ],
        "examples": [
          "{\"summary\":\"Invoice download is broken\",\"category\":\"billing\"}"
        ],
        "prepared_replies": [
          {
            "message": "hello",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          },
          {
            "message": "hello!",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          }
        ],
        "expected_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "summary",
            "category"
          ]
        },
        "required_fields": [
          "/summary",
          "/category"
        ],
        "required_any": [],
        "field_rules": [
          {
            "field": "/summary",
            "kind": "source_field",
            "source_pointer": "/summary"
          },
          {
            "field": "/category",
            "kind": "source_field",
            "source_pointer": "/category"
          },
          {
            "field": "/category",
            "kind": "enum",
            "allowed_values": [
              "billing",
              "technical",
              "account"
            ]
          }
        ],
        "cross_checks": [],
        "provider": "ollama",
        "model": "",
        "credential_id": "",
        "max_tokens": 2048
      }
    },
    {
      "id": "decision",
      "type": "condition",
      "version": 1,
      "label": "Business condition",
      "position": {
        "x": 300,
        "y": 380
      },
      "inputs": {
        "value": "reader.text"
      },
      "config": {
        "field": "category",
        "operator": "eq",
        "compare_to": "billing"
      }
    },
    {
      "id": "yesText",
      "type": "prompt",
      "version": 1,
      "label": "True branch explanation",
      "position": {
        "x": 70,
        "y": 550
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked ticket draft: billing queue. No ticket has been created.\nChecked value: {message}"
      }
    },
    {
      "id": "yes",
      "type": "response",
      "version": 1,
      "label": "True branch response",
      "position": {
        "x": 70,
        "y": 720
      },
      "inputs": {
        "text": "yesText.text"
      },
      "config": {}
    },
    {
      "id": "noText",
      "type": "prompt",
      "version": 1,
      "label": "False branch explanation",
      "position": {
        "x": 580,
        "y": 550
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked ticket draft: general support queue. No ticket has been created.\nChecked value: {message}"
      }
    },
    {
      "id": "no",
      "type": "response",
      "version": 1,
      "label": "False branch response",
      "position": {
        "x": 580,
        "y": 720
      },
      "inputs": {
        "text": "noText.text"
      },
      "config": {}
    },
    {
      "id": "readerReply",
      "type": "response",
      "version": 1,
      "label": "Reader reply",
      "position": {
        "x": -180,
        "y": 300
      },
      "inputs": {
        "text": "reader.reply"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-reader",
      "source": "input",
      "target": "reader"
    },
    {
      "id": "reader-decision",
      "source": "reader",
      "target": "decision",
      "sourceHandle": "continue"
    },
    {
      "id": "decision-yesText",
      "source": "decision",
      "target": "yesText",
      "sourceHandle": "true"
    },
    {
      "id": "yesText-yes",
      "source": "yesText",
      "target": "yes"
    },
    {
      "id": "decision-noText",
      "source": "decision",
      "target": "noText",
      "sourceHandle": "false"
    },
    {
      "id": "noText-no",
      "source": "noText",
      "target": "no"
    },
    {
      "id": "reader-readerReply",
      "source": "reader",
      "target": "readerReply",
      "sourceHandle": "reply"
    }
  ]
}
