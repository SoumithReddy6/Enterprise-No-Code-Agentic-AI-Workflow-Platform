{
  "version": 1,
  "contract": 2,
  "name": "Yes / no eligibility draft",
  "description": "Keep a model classification separate from a human decision. Eligibility requires suitable record evidence or review.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Chat input",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "records",
      "type": "tool_jira",
      "version": 1,
      "label": "Read independent reference records",
      "position": {
        "x": 300,
        "y": 210
      },
      "inputs": {
        "input": "input.message"
      },
      "config": {
        "connection_id": "",
        "operation": "search",
        "jql": "project = MEMBERS",
        "enable_writes": false
      }
    },
    {
      "id": "reader",
      "type": "request_reader",
      "version": 1,
      "label": "Request reader",
      "position": {
        "x": 300,
        "y": 380
      },
      "inputs": {
        "message": "input.message",
        "reference": "records.text"
      },
      "config": {
        "purpose": "Draft a yes/no eligibility decision for a named record. A model inference from prose is not proof of eligibility; confirm unknown interpretations with a person.",
        "accepted_requests": [
          "Eligibility questions about a named record."
        ],
        "excluded_requests": [
          "Unrelated questions and greetings without a request."
        ],
        "examples": [
          "Is record MEMBER-1 eligible?"
        ],
        "prepared_replies": [
          {
            "message": "hello",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          },
          {
            "message": "hello!",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          }
        ],
        "expected_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "eligible": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "record_id",
            "eligible"
          ]
        },
        "required_fields": [
          "/record_id",
          "/eligible"
        ],
        "required_any": [],
        "field_rules": [
          {
            "field": "/record_id",
            "kind": "quoted"
          },
          {
            "field": "/record_id",
            "kind": "reference_member",
            "reference_list": "/issues",
            "reference_key": "/key"
          },
          {
            "field": "/eligible",
            "kind": "quoted"
          }
        ],
        "cross_checks": [],
        "provider": "ollama",
        "model": "",
        "credential_id": "",
        "max_tokens": 2048
      }
    },
    {
      "id": "decision",
      "type": "condition",
      "version": 1,
      "label": "Business condition",
      "position": {
        "x": 300,
        "y": 550
      },
      "inputs": {
        "value": "reader.text"
      },
      "config": {
        "field": "eligible",
        "operator": "eq",
        "compare_to": "true",
        "compare_as": "text"
      }
    },
    {
      "id": "yesText",
      "type": "prompt",
      "version": 1,
      "label": "True branch explanation",
      "position": {
        "x": 70,
        "y": 720
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked or manually confirmed interpretation: yes. No entitlement has been granted.\nChecked value: {message}"
      }
    },
    {
      "id": "yes",
      "type": "response",
      "version": 1,
      "label": "True branch response",
      "position": {
        "x": 70,
        "y": 890
      },
      "inputs": {
        "text": "yesText.text"
      },
      "config": {}
    },
    {
      "id": "noText",
      "type": "prompt",
      "version": 1,
      "label": "False branch explanation",
      "position": {
        "x": 580,
        "y": 720
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked or manually confirmed interpretation: no. No external action has been sent.\nChecked value: {message}"
      }
    },
    {
      "id": "no",
      "type": "response",
      "version": 1,
      "label": "False branch response",
      "position": {
        "x": 580,
        "y": 890
      },
      "inputs": {
        "text": "noText.text"
      },
      "config": {}
    },
    {
      "id": "readerReply",
      "type": "response",
      "version": 1,
      "label": "Reader reply",
      "position": {
        "x": -180,
        "y": 470
      },
      "inputs": {
        "text": "reader.reply"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-records",
      "source": "input",
      "target": "records"
    },
    {
      "id": "records-reader",
      "source": "records",
      "target": "reader"
    },
    {
      "id": "reader-decision",
      "source": "reader",
      "target": "decision",
      "sourceHandle": "continue"
    },
    {
      "id": "decision-yesText",
      "source": "decision",
      "target": "yesText",
      "sourceHandle": "true"
    },
    {
      "id": "yesText-yes",
      "source": "yesText",
      "target": "yes"
    },
    {
      "id": "decision-noText",
      "source": "decision",
      "target": "noText",
      "sourceHandle": "false"
    },
    {
      "id": "noText-no",
      "source": "noText",
      "target": "no"
    },
    {
      "id": "reader-readerReply",
      "source": "reader",
      "target": "readerReply",
      "sourceHandle": "reply"
    }
  ]
}
