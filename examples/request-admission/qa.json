{
  "version": 1,
  "contract": 2,
  "name": "My first AI workflow",
  "description": "Answer broad questions. Narrative replies do not authorize business actions.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Chat input",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "reader",
      "type": "request_reader",
      "version": 1,
      "label": "Request reader",
      "position": {
        "x": 300,
        "y": 210
      },
      "inputs": {
        "message": "input.message"
      },
      "config": {
        "purpose": "Answer general questions and help explain topics. A greeting or a message with no question gets a reply.",
        "accepted_requests": [
          "General questions, explanations and requests for help."
        ],
        "excluded_requests": [
          "Requests to perform external actions or approve business transactions."
        ],
        "examples": [
          "How do AI workflows work?"
        ],
        "prepared_replies": [
          {
            "message": "hello",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          },
          {
            "message": "hello!",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          }
        ],
        "expected_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "question"
          ]
        },
        "required_fields": [
          "/question"
        ],
        "required_any": [],
        "field_rules": [
          {
            "field": "/question",
            "kind": "accept_quoted"
          }
        ],
        "cross_checks": [],
        "provider": "ollama",
        "model": "",
        "credential_id": "",
        "max_tokens": 2048
      }
    },
    {
      "id": "agent",
      "type": "agent",
      "version": 1,
      "label": "Agent",
      "position": {
        "x": 300,
        "y": 380
      },
      "inputs": {
        "input": "input.message"
      },
      "config": {
        "provider": "ollama",
        "model": "",
        "credential_id": "",
        "max_tokens": 2048,
        "role": "reasoner",
        "system": "Answer the user question clearly. Ask for clarification when needed. Do not claim to have taken external actions.",
        "user_prompt": "{input}",
        "max_steps": 6,
        "memory_key": "default"
      }
    },
    {
      "id": "response",
      "type": "response",
      "version": 1,
      "label": "Response",
      "position": {
        "x": 300,
        "y": 550
      },
      "inputs": {
        "text": "agent.text"
      },
      "config": {}
    },
    {
      "id": "readerReply",
      "type": "response",
      "version": 1,
      "label": "Reader reply",
      "position": {
        "x": -180,
        "y": 300
      },
      "inputs": {
        "text": "reader.reply"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-reader",
      "source": "input",
      "target": "reader"
    },
    {
      "id": "reader-agent",
      "source": "reader",
      "target": "agent",
      "sourceHandle": "continue"
    },
    {
      "id": "agent-response",
      "source": "agent",
      "target": "response"
    },
    {
      "id": "reader-readerReply",
      "source": "reader",
      "target": "readerReply",
      "sourceHandle": "reply"
    }
  ]
}
