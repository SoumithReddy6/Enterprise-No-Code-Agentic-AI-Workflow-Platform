{
  "version": 1,
  "contract": 2,
  "name": "Refund request draft",
  "description": "Check the order identifier and requested amount before applying the example amount policy. Order records must be connected or reviewed.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Chat input",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "records",
      "type": "tool_jira",
      "version": 1,
      "label": "Read independent reference records",
      "position": {
        "x": 300,
        "y": 210
      },
      "inputs": {
        "input": "input.message"
      },
      "config": {
        "connection_id": "",
        "operation": "search",
        "jql": "project = ORDERS",
        "enable_writes": false
      }
    },
    {
      "id": "reader",
      "type": "request_reader",
      "version": 1,
      "label": "Request reader",
      "position": {
        "x": 300,
        "y": 380
      },
      "inputs": {
        "message": "input.message",
        "reference": "records.text"
      },
      "config": {
        "purpose": "Draft refund request routing for a stated order identifier and amount. Request facts are separate from refund eligibility and payment authorization.",
        "accepted_requests": [
          "Refund requests with an order identifier and an amount."
        ],
        "excluded_requests": [
          "Unrelated questions and greetings without a request."
        ],
        "examples": [
          "{\"order_id\":\"ORDER-1\",\"amount\":24}"
        ],
        "prepared_replies": [
          {
            "message": "hello",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          },
          {
            "message": "hello!",
            "reply": "Hello! Send your request and I will check whether this workflow can help."
          }
        ],
        "expected_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "order_id",
            "amount"
          ]
        },
        "required_fields": [
          "/order_id",
          "/amount"
        ],
        "required_any": [],
        "field_rules": [
          {
            "field": "/order_id",
            "kind": "quoted"
          },
          {
            "field": "/order_id",
            "kind": "reference_member",
            "reference_list": "/issues",
            "reference_key": "/key"
          },
          {
            "field": "/amount",
            "kind": "source_field",
            "source_pointer": "/amount"
          }
        ],
        "cross_checks": [],
        "provider": "ollama",
        "model": "",
        "credential_id": "",
        "max_tokens": 2048
      }
    },
    {
      "id": "decision",
      "type": "condition",
      "version": 1,
      "label": "Business condition",
      "position": {
        "x": 300,
        "y": 550
      },
      "inputs": {
        "value": "reader.text"
      },
      "config": {
        "field": "amount",
        "operator": "lte",
        "compare_to": "100"
      }
    },
    {
      "id": "yesText",
      "type": "prompt",
      "version": 1,
      "label": "True branch explanation",
      "position": {
        "x": 70,
        "y": 720
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked refund request is within the example $100 review threshold. Eligibility is not established and no refund has been issued.\nChecked value: {message}"
      }
    },
    {
      "id": "yes",
      "type": "response",
      "version": 1,
      "label": "True branch response",
      "position": {
        "x": 70,
        "y": 890
      },
      "inputs": {
        "text": "yesText.text"
      },
      "config": {}
    },
    {
      "id": "noText",
      "type": "prompt",
      "version": 1,
      "label": "False branch explanation",
      "position": {
        "x": 580,
        "y": 720
      },
      "inputs": {
        "message": "reader.text"
      },
      "config": {
        "template": "Checked refund request exceeds the example $100 threshold. Follow the refund review policy; no refund has been issued.\nChecked value: {message}"
      }
    },
    {
      "id": "no",
      "type": "response",
      "version": 1,
      "label": "False branch response",
      "position": {
        "x": 580,
        "y": 890
      },
      "inputs": {
        "text": "noText.text"
      },
      "config": {}
    },
    {
      "id": "readerReply",
      "type": "response",
      "version": 1,
      "label": "Reader reply",
      "position": {
        "x": -180,
        "y": 470
      },
      "inputs": {
        "text": "reader.reply"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-records",
      "source": "input",
      "target": "records"
    },
    {
      "id": "records-reader",
      "source": "records",
      "target": "reader"
    },
    {
      "id": "reader-decision",
      "source": "reader",
      "target": "decision",
      "sourceHandle": "continue"
    },
    {
      "id": "decision-yesText",
      "source": "decision",
      "target": "yesText",
      "sourceHandle": "true"
    },
    {
      "id": "yesText-yes",
      "source": "yesText",
      "target": "yes"
    },
    {
      "id": "decision-noText",
      "source": "decision",
      "target": "noText",
      "sourceHandle": "false"
    },
    {
      "id": "noText-no",
      "source": "noText",
      "target": "no"
    },
    {
      "id": "reader-readerReply",
      "source": "reader",
      "target": "readerReply",
      "sourceHandle": "reply"
    }
  ]
}
