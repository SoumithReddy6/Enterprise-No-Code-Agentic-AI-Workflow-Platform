{
  "version": 1,
  "name": "Purchase routing",
  "description": "An extraction agent reads the order total. Messages with no order total are turned away before any approval decision; orders over $1,000 go to human review and the rest are approved.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Purchase request",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "extract",
      "type": "agent",
      "version": 1,
      "label": "Extract amount",
      "position": {
        "x": 300,
        "y": 220
      },
      "inputs": {
        "input": "input.message"
      },
      "config": {
        "provider": "ollama",
        "model": "llama3.1:latest",
        "credential_id": "",
        "role": "extraction",
        "system": "You read purchase requests. Whatever the message is (an order, a greeting, a question or anything else), respond with only one JSON object with one key, amount, and nothing else. For an order whose total is $1,350, respond {\"amount\": 1350}. If the message is not an order, or states no total, respond {\"amount\": null}. Never guess an amount.",
        "user_prompt": "{input}",
        "temperature": 0,
        "max_tokens": 200,
        "max_steps": 6,
        "memory_key": "default",
        "output_schema": {
          "type": "object",
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "amount"
          ]
        }
      }
    },
    {
      "id": "gate",
      "type": "condition",
      "version": 1,
      "label": "Order total found?",
      "position": {
        "x": 300,
        "y": 400
      },
      "inputs": {
        "value": "extract.text"
      },
      "config": {
        "operator": "empty",
        "field": "amount",
        "case_sensitive": false
      }
    },
    {
      "id": "check",
      "type": "condition",
      "version": 1,
      "label": "Over $1,000?",
      "position": {
        "x": 140,
        "y": 580
      },
      "inputs": {
        "value": "extract.text"
      },
      "config": {
        "operator": "gt",
        "field": "amount",
        "compare_to": "1000",
        "case_sensitive": false
      }
    },
    {
      "id": "review_note",
      "type": "prompt",
      "version": 1,
      "label": "Review message",
      "position": {
        "x": -60,
        "y": 760
      },
      "inputs": {
        "message": "extract.text"
      },
      "config": {
        "template": "Routed to human review: the order total is over $1,000. A manager must approve it before purchase.\nExtracted: {message}"
      }
    },
    {
      "id": "auto_note",
      "type": "prompt",
      "version": 1,
      "label": "Approval message",
      "position": {
        "x": 320,
        "y": 760
      },
      "inputs": {
        "message": "extract.text"
      },
      "config": {
        "template": "Auto-approved: the order total is $1,000 or less. No review needed.\nExtracted: {message}"
      }
    },
    {
      "id": "none_note",
      "type": "prompt",
      "version": 1,
      "label": "Rejection message",
      "position": {
        "x": 620,
        "y": 580
      },
      "inputs": {
        "message": "input.message"
      },
      "config": {
        "template": "Not a purchase request: no order total was found, so nothing was approved or sent for review.\nMessage: {message}"
      }
    },
    {
      "id": "review",
      "type": "response",
      "version": 1,
      "label": "Needs review",
      "position": {
        "x": -60,
        "y": 940
      },
      "inputs": {
        "text": "review_note.text"
      },
      "config": {}
    },
    {
      "id": "auto",
      "type": "response",
      "version": 1,
      "label": "Auto-approved",
      "position": {
        "x": 320,
        "y": 940
      },
      "inputs": {
        "text": "auto_note.text"
      },
      "config": {}
    },
    {
      "id": "none",
      "type": "response",
      "version": 1,
      "label": "Not a purchase request",
      "position": {
        "x": 620,
        "y": 760
      },
      "inputs": {
        "text": "none_note.text"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-extract",
      "source": "input",
      "target": "extract"
    },
    {
      "id": "check-review-note",
      "source": "check",
      "target": "review_note",
      "sourceHandle": "true"
    },
    {
      "id": "review-note-review",
      "source": "review_note",
      "target": "review"
    },
    {
      "id": "check-auto-note",
      "source": "check",
      "target": "auto_note",
      "sourceHandle": "false"
    },
    {
      "id": "auto-note-auto",
      "source": "auto_note",
      "target": "auto"
    },
    {
      "id": "extract-gate",
      "source": "extract",
      "target": "gate"
    },
    {
      "id": "gate-none",
      "source": "gate",
      "target": "none_note",
      "sourceHandle": "true"
    },
    {
      "id": "gate-check",
      "source": "gate",
      "target": "check",
      "sourceHandle": "false"
    },
    {
      "id": "none-note-none",
      "source": "none_note",
      "target": "none"
    }
  ]
}
