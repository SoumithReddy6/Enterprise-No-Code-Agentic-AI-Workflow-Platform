{
  "version": 1,
  "name": "Purchase routing",
  "description": "An extraction agent reads the order parts; a Calculate node computes the total in code. Messages with no total are turned away before any approval decision; orders over $1,000 go to human review and the rest are approved.",
  "nodes": [
    {
      "id": "input",
      "type": "chat_input",
      "version": 1,
      "label": "Purchase request",
      "position": {
        "x": 300,
        "y": 40
      },
      "inputs": {},
      "config": {}
    },
    {
      "id": "extract",
      "type": "agent",
      "version": 1,
      "label": "Extract amount",
      "position": {
        "x": 300,
        "y": 220
      },
      "inputs": {
        "input": "input.message"
      },
      "config": {
        "provider": "ollama",
        "model": "llama3.1:latest",
        "credential_id": "",
        "role": "extraction",
        "system": "You read purchase requests. Whatever the message is (an order, a greeting, a question or anything else), respond with only one JSON object with the keys item, quantity, unit_price and total, and nothing else. item is the name of the product being bought, never a verb such as \"buy\" or \"order\". Copy each value exactly as the message states it, and use null for anything it does not state. If the message gives a price per item, put it in unit_price; if it gives one price for the whole order, put it in total. Never calculate a total yourself, and never guess. For \"3 laptops at $450 each\" respond {\"item\": \"laptops\", \"quantity\": 3, \"unit_price\": 450, \"total\": null}. For \"a monitor for $1,200\" respond {\"item\": \"monitor\", \"quantity\": null, \"unit_price\": null, \"total\": 1200}.",
        "user_prompt": "{input}",
        "temperature": 0,
        "max_tokens": 200,
        "max_steps": 6,
        "memory_key": "default",
        "output_schema": {
          "type": "object",
          "properties": {
            "item": {
              "type": [
                "string",
                "null"
              ]
            },
            "quantity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "unit_price": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "item",
            "quantity",
            "unit_price",
            "total"
          ]
        }
      }
    },
    {
      "id": "total",
      "type": "calculate",
      "version": 1,
      "label": "Order total",
      "position": {
        "x": 300,
        "y": 400
      },
      "inputs": {
        "value": "extract.text"
      },
      "config": {
        "expression": "coalesce(total, quantity * unit_price)",
        "mode": "compute"
      }
    },
    {
      "id": "gate",
      "type": "condition",
      "version": 1,
      "label": "Order total found?",
      "position": {
        "x": 300,
        "y": 580
      },
      "inputs": {
        "value": "total.text"
      },
      "config": {
        "operator": "empty",
        "field": "result",
        "case_sensitive": false
      }
    },
    {
      "id": "check",
      "type": "condition",
      "version": 1,
      "label": "Over $1,000?",
      "position": {
        "x": 140,
        "y": 760
      },
      "inputs": {
        "value": "total.text"
      },
      "config": {
        "operator": "gt",
        "compare_to": "1000",
        "field": "result",
        "case_sensitive": false
      }
    },
    {
      "id": "review_note",
      "type": "prompt",
      "version": 1,
      "label": "Review message",
      "position": {
        "x": -60,
        "y": 940
      },
      "inputs": {
        "message": "total.text"
      },
      "config": {
        "template": "Routed to human review: the order total is over $1,000. A manager must approve it before purchase.\nCalculated: {message}"
      }
    },
    {
      "id": "auto_note",
      "type": "prompt",
      "version": 1,
      "label": "Approval message",
      "position": {
        "x": 320,
        "y": 940
      },
      "inputs": {
        "message": "total.text"
      },
      "config": {
        "template": "Auto-approved: the order total is $1,000 or less. No review needed.\nCalculated: {message}"
      }
    },
    {
      "id": "none_note",
      "type": "prompt",
      "version": 1,
      "label": "Rejection message",
      "position": {
        "x": 620,
        "y": 760
      },
      "inputs": {
        "message": "input.message"
      },
      "config": {
        "template": "Not a purchase request: no order total was found, so nothing was approved or sent for review.\nMessage: {message}"
      }
    },
    {
      "id": "review",
      "type": "response",
      "version": 1,
      "label": "Needs review",
      "position": {
        "x": -60,
        "y": 1120
      },
      "inputs": {
        "text": "review_note.text"
      },
      "config": {}
    },
    {
      "id": "auto",
      "type": "response",
      "version": 1,
      "label": "Auto-approved",
      "position": {
        "x": 320,
        "y": 1120
      },
      "inputs": {
        "text": "auto_note.text"
      },
      "config": {}
    },
    {
      "id": "none",
      "type": "response",
      "version": 1,
      "label": "Not a purchase request",
      "position": {
        "x": 620,
        "y": 940
      },
      "inputs": {
        "text": "none_note.text"
      },
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "input-extract",
      "source": "input",
      "target": "extract"
    },
    {
      "id": "check-review-note",
      "source": "check",
      "target": "review_note",
      "sourceHandle": "true"
    },
    {
      "id": "review-note-review",
      "source": "review_note",
      "target": "review"
    },
    {
      "id": "check-auto-note",
      "source": "check",
      "target": "auto_note",
      "sourceHandle": "false"
    },
    {
      "id": "auto-note-auto",
      "source": "auto_note",
      "target": "auto"
    },
    {
      "id": "gate-none",
      "source": "gate",
      "target": "none_note",
      "sourceHandle": "true"
    },
    {
      "id": "gate-check",
      "source": "gate",
      "target": "check",
      "sourceHandle": "false"
    },
    {
      "id": "none-note-none",
      "source": "none_note",
      "target": "none"
    },
    {
      "id": "extract-total",
      "source": "extract",
      "target": "total"
    },
    {
      "id": "total-gate",
      "source": "total",
      "target": "gate"
    }
  ]
}
