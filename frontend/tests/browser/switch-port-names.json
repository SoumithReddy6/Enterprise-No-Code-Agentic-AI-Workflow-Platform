 "file": {
  "name": "Switch cases named like loop ports",
  "contract": 2,
  "nodes": [
   {
    "id": "input",
    "type": "chat_input",
    "position": {
     "x": 300,
     "y": 40
    }
   },
   {
    "id": "reader",
    "type": "request_reader",
    "version": 1,
    "label": "Request reader",
    "position": {
     "x": 300,
     "y": 200
    },
    "inputs": {
     "message": "input.message"
    },
    "config": {
     "purpose": "Draft support tickets with a summary and a category of billing, technical or account. General unrelated questions are outside this workflow.",
     "accepted_requests": [
      "Support problems with a summary and a category."
     ],
     "excluded_requests": [
      "Unrelated questions and greetings without a request."
     ],
     "examples": [
      "{\"summary\":\"Invoice download is broken\",\"category\":\"billing\"}"
     ],
     "prepared_replies": [
      {
       "message": "hello",
       "reply": "Hello! Send your request and I will check whether this workflow can help."
      },
      {
       "message": "hello!",
       "reply": "Hello! Send your request and I will check whether this workflow can help."
      }
     ],
     "expected_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "summary": {
        "type": [
         "string",
         "null"
        ]
       },
       "category": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "summary",
       "category"
      ]
     },
     "required_fields": [
      "/summary",
      "/category"
     ],
     "required_any": [],
     "field_rules": [
      {
       "field": "/summary",
       "kind": "source_field",
       "source_pointer": "/summary"
      },
      {
       "field": "/category",
       "kind": "source_field",
       "source_pointer": "/category"
      },
      {
       "field": "/category",
       "kind": "enum",
       "allowed_values": [
        "billing",
        "technical",
        "account"
       ]
      }
     ],
     "cross_checks": [],
     "provider": "ollama",
     "model": "tiny:latest",
     "credential_id": "",
     "max_tokens": 2048
    }
   },
   {
    "id": "route",
    "type": "switch",
    "inputs": {
     "value": "reader.text"
    },
    "config": {
     "cases": [
      {
       "id": "body",
       "label": "Body",
       "when": {
        "field": "category",
        "operator": "eq",
        "compare_to": "billing"
       }
      },
      {
       "id": "check",
       "label": "Check",
       "when": {
        "field": "category",
        "operator": "eq",
        "compare_to": "technical"
       }
      },
      {
       "id": "flow",
       "label": "Flow",
       "when": {
        "field": "category",
        "operator": "eq",
        "compare_to": "account"
       }
      },
      {
       "id": "agents",
       "label": "Agents",
       "when": {
        "field": "category",
        "operator": "eq",
        "compare_to": "sales"
       }
      },
      {
       "id": "output",
       "label": "Output",
       "when": {
        "field": "category",
        "operator": "eq",
        "compare_to": "other"
       }
      }
     ]
    },
    "position": {
     "x": 300,
     "y": 380
    }
   },
   {
    "id": "replied",
    "type": "response",
    "inputs": {
     "text": "reader.reply"
    },
    "position": {
     "x": 700,
     "y": 200
    }
   },
   {
    "id": "out_body",
    "type": "response",
    "inputs": {
     "text": "input.message"
    },
    "position": {
     "x": 760,
     "y": 860
    }
   },
   {
    "id": "out_check",
    "type": "response",
    "inputs": {
     "text": "input.message"
    },
    "position": {
     "x": 1010,
     "y": 860
    }
   },
   {
    "id": "out_flow",
    "type": "response",
    "inputs": {
     "text": "input.message"
    },
    "position": {
     "x": 1260,
     "y": 860
    }
   },
   {
    "id": "out_agents",
    "type": "response",
    "inputs": {
     "text": "input.message"
    },
    "position": {
     "x": 1510,
     "y": 860
    }
   },
   {
    "id": "out_output",
    "type": "response",
    "inputs": {
     "text": "input.message"
    },
    "position": {
     "x": 1760,
     "y": 860
    }
   },
   {
    "id": "out_default",
